{
  "name": "bsky-live-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bluesky のハッシュタグ投稿をイベント会場モニターへリアルタイム表示するライブウォール",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@fastify/static": "^8.0.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
