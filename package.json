{
  "name": "bsky-live-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bluesky のハッシュタグ投稿をイベント会場モニターへリアルタイム表示するライブウォール",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "vite build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"test/*.test.js\"",
    "dev:admin": "vite build --watch"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@atproto/oauth-client-node": "^0.5.4",
    "@awesome.me/webawesome": "^3.12.0",
    "@fastify/static": "^8.0.4",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "svelte": "^5.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
