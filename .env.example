# ===== 運用モード =====
# false : 単一テナント (会場ローカル)。設定は .env、URL は /wall, /wall/<id>, /admin
# true  : マルチテナント (共有サービス)。URL は /e/<tenant>/wall/<id>、
#         テナント設定は DATA_FILE に永続化する。AUTH_MODE=oauth が必須
MULTI_TENANT=false

# テナント設定の保存先 (MULTI_TENANT=true のときのみ使用)。
# コンテナ運用ではこのパスをボリュームにすること。
DATA_FILE=./data/wall.db
# 会場モニターに出す任意画像 (QR など) の保存先。
# local : このホストのディスク (UPLOAD_DIR)
# s3    : S3 互換ストレージ (Cloudflare R2 / MEGA S4 / AWS S3 / Backblaze B2 など)
STORAGE_DRIVER=local
# STORAGE_DRIVER=local のときの保存先。コンテナではボリュームにすること
UPLOAD_DIR=./data/uploads

# ----- STORAGE_DRIVER=s3 のときだけ使う -----
# 例) Cloudflare R2 : https://<アカウント ID>.r2.cloudflarestorage.com  (S3_REGION=auto)
#     AWS S3        : https://s3.ap-northeast-1.amazonaws.com           (S3_REGION=ap-northeast-1)
#     Backblaze B2  : https://s3.us-west-004.backblazeb2.com            (S3_REGION=us-west-004)
#     MEGA S4       : 管理画面に表示される S3 エンドポイント
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# キーの接頭辞 (バケットを他と共有する場合)。例: bsky-live-wall/
S3_PREFIX=
# 画像を直接配る URL の基点 (公開バケットやカスタムドメイン)。
# 空にするとアプリが /uploads/<key> で中継する (バケットは非公開のままでよい)
S3_PUBLIC_BASE_URL=
# https://<endpoint>/<bucket>/<key> の形で叩く。false で仮想ホスト形式
S3_FORCE_PATH_STYLE=true

# ===== イベント (テナント) =====
# URL に `/e/<EVENT_ID>/` として現れる識別子。
# 現状は 1 サーバー 1 イベントだが、将来のマルチテナント化で URL を
# 変えずに済むよう、この段階から経路に組み込んでいる。
# 使える文字は英小文字・数字・ハイフン・アンダースコア。
EVENT_ID=default

# ===== 表示対象 =====
# 監視するハッシュタグ。# は付けても付けなくてもよい。カンマ区切りで複数指定可。
# 空でも起動する (キーワードのみ、または管理画面から後で設定する運用)。
HASHTAGS=
# ハッシュタグ以外に監視するキーワード (カンマ区切り、本文の部分一致)。
# ハッシュタグと違い、イベントを知らない第三者の投稿も拾ってしまう点に注意。
KEYWORDS=
# 会場モニターのヘッダに出すイベント名
EVENT_TITLE=Bluesky Live Wall
# ヘッダのサブテキスト (会場名など)
EVENT_SUBTITLE=
# イベント名に含まれる「Bluesky」を Bluesky のロゴアイコン (ブランドカラー) で表示するか
# テナント単位の設定。管理画面からも切り替えられる
SHOW_BLUESKY_LOGO=true
# 会場モニターのタイトルのグラデーションをゆっくり動かすか (既定は止める)
# 動きを減らす設定の端末では自動的に止まる
ANIMATE_TITLE_GRADIENT=false

# ===== サーバー =====
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ===== Docker Compose 用 =====
# ホスト側のどのアドレス・ポートに出すか (compose.yaml が参照する)。
# 127.0.0.1 はそのホストの中からしか届かない。LXC / VM の中で動かし、
# 親ホストや LAN 内の別機材 (cloudflared や nginx) から叩く場合は 0.0.0.0 にし、
# 届く経路はファイアウォールで絞ること。
BIND_ADDR=127.0.0.1
BIND_PORT=3000
# TLS 終端まで Caddy に任せる場合のみ設定する (docker compose --profile caddy up -d)
WALL_DOMAIN=

# ===== リバースプロキシ / リモート公開 =====
# nginx / Caddy などのリバースプロキシ配下で動かす場合は true にする。
# X-Forwarded-For を信頼して実クライアント IP を判定するようになる。
# true にすると ADMIN_TOKEN が必須になる (未設定だと起動しない)。
# プロキシ配下ではリモートの利用者も loopback アドレスに見えるため、
# トークンなしの loopback 例外を有効にしたままだと誰でも管理 API を操作できてしまう。
TRUST_PROXY=false

# ===== Jetstream =====
# 主接続先。カンマ区切りで指定した順にフェイルオーバーする。
JETSTREAM_HOSTS=jetstream2.us-east.bsky.network,jetstream1.us-east.bsky.network,jetstream2.us-west.bsky.network,jetstream1.us-west.bsky.network
# 再接続バックオフ (ミリ秒)
JETSTREAM_RECONNECT_MIN_MS=500
JETSTREAM_RECONNECT_MAX_MS=30000
# 同一ホストで連続失敗したら次のホストへ切り替える回数
JETSTREAM_HOST_FAILOVER_AFTER=3
# 再接続時に巻き戻す最大秒数 (0 で cursor を使わない)
JETSTREAM_REPLAY_WINDOW_SEC=30
# 起動時に過去へ遡って投稿を拾う分数 (既定 0 = 起動時は行わない)。
# 管理画面から任意の時点で実行できるため、通常は 0 のままでよい。
# 会場 PC の起動と同時に自動で埋めたい場合のみ値を入れる。
# 実測: 60 分の再生に約 27 秒、180 分に約 76 秒かかってから現在に追いつく。
# Jetstream の保持期間はおよそ 36 時間 (2160 分) が上限。
STARTUP_BACKFILL_MINUTES=0

# ===== 保持・表示 =====
# サーバー側リングバッファの保持件数
BUFFER_SIZE=200
# 新規接続時に送るバックログ件数 (会場モニターで遡れる件数の初期値)
BACKLOG_SIZE=40
# 会場モニターが DOM 上に保持する最大カード数 (これを超えると古いものから消える)
# スクロールで遡れる範囲でもある
WALL_MAX_CARDS=40
# 会場モニターのカラム数。1 で縦に流れる (既定)。2 以上で横並びのグリッドになる
WALL_COLUMNS=1
# カードの最大表示秒数 (0 で無期限。押し出されるまで残る)
WALL_CARD_TTL_SEC=0
# 会場モニターのヘッダに監視語を表示するか
WALL_SHOW_TERMS=true
# ヘッダに監視キーワードも表示するか (既定は出さない。投稿者に促すものではないため)
WALL_SHOW_KEYWORDS=false
# 会場モニター右上の時計を表示するか
WALL_SHOW_CLOCK=true
# 時計に秒を表示するか (時分の右下に小さく添える)
# false のときは時分の区切り「:」が 1 秒ごとに点滅する
WALL_SHOW_SECONDS=true

# 管理画面の「遡る時間」の候補 (分、カンマ区切り)。テナントごとに足し引きできる
BACKFILL_PRESETS=30,120,360,1440

# ===== モデレーション =====
# open   : 受信した投稿をそのまま表示
# approve: 運営が管理画面で承認した投稿のみ表示
MODERATION_MODE=open
# 既定ウォールの除外キーワードの初期値 (カンマ区切り、本文の部分一致)
# 一致した投稿は監視語に当たっていても拾わない。以後は管理画面から編集する
EXCLUDE_WORDS=
# 表示しない語 (カンマ区切り、部分一致、大文字小文字を無視)
NG_WORDS=
# 表示しない正規表現 (カンマ区切り)
NG_PATTERNS=
# 表示しない DID / ハンドル (カンマ区切り)
BLOCK_ACTORS=
# リプライを表示するか
ALLOW_REPLIES=true
# 自己申告ラベル (porn, sexual, nudity, graphic-media 等) が付く投稿を除外するか
FILTER_LABELED=true
# 表示を許可する言語 (カンマ区切り、空なら全言語)
ALLOWED_LANGS=
# キーワードだけで一致した投稿を承認待ちに回すか。
# ハッシュタグは投稿者が明示的に付けた意思表示だが、キーワード一致はそうではない。
# 会場スクリーンに無関係な投稿を出さないため、既定では運営の確認を挟む。
KEYWORD_REQUIRE_APPROVAL=true
# 画像を表示するか
SHOW_IMAGES=true

# ===== 管理画面 =====
# 空にすると管理 API は localhost からのみ受け付ける
ADMIN_TOKEN=
# 管理セッションの有効時間 (時間)。この時間を過ぎたログインは自動的に失効する。
# イベントの最大長に合わせておく。
ADMIN_SESSION_TTL_HOURS=12

# ===== 管理画面の認証方式 =====
# token : ADMIN_TOKEN によるログイン (既定。会場 PC での単独運用向け)
# oauth : AT Protocol アカウント (Bluesky) でログイン
# both  : 両方を受け付ける
AUTH_MODE=token

# AUTH_MODE に oauth を含める場合に必須。公開 URL (末尾スラッシュなし)。
# client_id とコールバック URL の組み立てに使う。
PUBLIC_URL=

# 管理を許可するアカウント (ハンドルまたは DID をカンマ区切り)。最初の 1 人を通すための
# 入口。MULTI_TENANT=true では、管理画面から招待したメンバー (テナントのメンバー表に
# 載っている人) とシステム管理者も、ここに書かなくてもログインできる。
# 何ができるかはテナントごとの役割で決まる。
# 例: ADMIN_ACTORS=alice.bsky.social,did:plc:xxxxxxxxxxxx
ADMIN_ACTORS=

# システム管理者 (ハンドルまたは DID をカンマ区切り)。全テナントを owner 相当で
# 管理できる。テナントのメンバー表 (DB) ではなくここで持つ。テナントが 1 件も
# 無い初期状態でも管理者が必要で、DB が壊れても締め出されないようにするため。
# MULTI_TENANT=true で空のままだと警告が出る (テナントの owner だけで運用する
# 構成も許容するためエラーにはしない)。
SYSTEM_ADMINS=

# localhost で OAuth を試すときだけ true にする。本番では使わない。
OAUTH_ALLOW_HTTP=false

# ===== AppView (プロフィール取得) =====
APPVIEW_URL=https://public.api.bsky.app
PROFILE_CACHE_TTL_SEC=900

# ===== カスタムフィード (任意機能) =====
# true にすると /xrpc/app.bsky.feed.getFeedSkeleton を公開する
FEED_GENERATOR_ENABLED=false
# フィードジェネレータの did:web ホスト名 (例: feed.example.com)
FEED_GENERATOR_HOSTNAME=
# 公開する feed の rkey
FEED_GENERATOR_RKEY=event-wall
# フィード発行者の DID
FEED_GENERATOR_PUBLISHER_DID=
